pkgname=argvus-notifications
pkgver=0.1.0
pkgrel=1
pkgdesc="Notification configuration and Dunst integration for the ARGVUS desktop"
arch=('any')
url="https://github.com/argvus/argvus-notifications"
license=('GPL-3.0-only')
depends=('argvus-session' 'argvus-i18n' 'dunst' 'libnotify')
optdepends=('rofi: notification action menu')
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_notifications_payload
}

package() {
  arch_package_notifications_payload
}
