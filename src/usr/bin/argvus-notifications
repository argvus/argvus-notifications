#!/usr/bin/env bash
set -eu

ARGVUS_NOTIFICATIONS_HELPER="${ARGVUS_NOTIFICATIONS_HELPER:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/notifications/sh/theme.sh}"
# shellcheck disable=SC1090,SC1091
. "$ARGVUS_NOTIFICATIONS_HELPER"

usage() {
  printf '%s\n' \
    'Usage: argvus notifications status' \
    '       argvus notifications dnd status|on|off|toggle|restore' \
    '       argvus notifications theme apply|restore [theme]' \
    '       argvus notifications theme reload [dunstrc]'
}

die() {
  printf 'argvus-notifications: %s\n' "$1" >&2
  exit 1
}

have_dunstctl() {
  command -v dunstctl >/dev/null 2>&1 || die 'dunstctl is not available'
}

read_dnd() {
  have_dunstctl
  value="$(dunstctl is-paused 2>/dev/null || true)"
  case "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" in
    true) printf 'true\n' ;;
    false) printf 'false\n' ;;
    *) die 'Dunst returned an invalid pause state' ;;
  esac
}

print_status() {
  printf 'dnd=%s\n' "$(read_dnd)"
}

state_file="${XDG_STATE_HOME:-${HOME:?}/.local/state}/argvus/notifications/dnd"
pending_theme_reload_file="${state_file%/*}/theme-reload-pending"
state_lock_file="${state_file}.lock"
active_theme_file="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-${HOME:?}/.config}}/argvus/data/.active-theme"

remember() {
  mkdir -p "$(dirname "$state_file")"
  umask 077
  printf '%s\n' "$1" >"$state_file"
}

acquire_state_lock() {
  mkdir -p "${state_file%/*}" || die 'failed to create notification state directory'
  command -v flock >/dev/null 2>&1 || die 'flock is not available'
  exec {state_lock_fd}>"$state_lock_file" || die 'failed to open notification state lock'
  flock -x "$state_lock_fd" || die 'failed to lock notification state'
}

restore_dnd_after_reload_failure() {
  if dunstctl set-paused true >/dev/null 2>&1; then
    remember true
    dunstctl close-all >/dev/null 2>&1 || true
  fi
}

apply_pending_theme_reload() {
  if dunstctl reload >/dev/null 2>&1; then
    dunstctl set-paused false >/dev/null 2>&1 || {
      restore_dnd_after_reload_failure
      die 'failed to disable DND after applying the pending notification theme'
    }
    rm -f -- "$pending_theme_reload_file" || {
      restore_dnd_after_reload_failure
      die 'failed to clear the pending notification theme reload'
    }
  else
    restore_dnd_after_reload_failure
    die 'failed to apply the pending notification theme; DND remains enabled'
  fi
}

set_dnd() {
  case "$1" in
    true|false) ;;
    *) die 'DND value must be true or false' ;;
  esac
  have_dunstctl
  if [ "$1" = false ] && [ -e "$pending_theme_reload_file" ]; then
    apply_pending_theme_reload
  else
    dunstctl set-paused "$1" >/dev/null 2>&1 || die 'failed to change Dunst pause state'
  fi
  if [ "$1" = true ]; then
    # Pausing prevents new popups, but does not dismiss notifications already
    # visible on screen. Dunst keeps those notifications in its history.
    dunstctl close-all >/dev/null 2>&1 || die 'failed to close displayed notifications'
  fi
  remember "$1"
  print_status
}

restore_dnd() {
  value="$1"
  case "$value" in
    true|false) ;;
    *) die 'DND value must be true or false' ;;
  esac
  have_dunstctl
  # Restore only Dunst's pause bit. Do not rewrite state or theme files.
  # Dunst is started immediately before this hook and may not have acquired
  # its D-Bus name yet. Retry briefly instead of making the service startup
  # race leave the runtime state out of sync with the persisted preference.
  attempt=0
  while ! dunstctl set-paused "$value" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 20 ] || die 'failed to restore Dunst pause state'
    sleep 0.1
  done
  if [ "$value" = true ]; then
    dunstctl close-all >/dev/null 2>&1 || die 'failed to close displayed notifications'
  fi
  # A fresh Dunst process loaded the current theme configuration at startup.
  rm -f -- "$pending_theme_reload_file" || die 'failed to clear the pending notification theme reload'
  print_status
}

toggle_dnd() {
  current="$(read_dnd)"
  if [ "$current" = true ]; then
    set_dnd false
  else
    set_dnd true
  fi
}

restore_theme() {
  local theme
  theme="$(tr -d '[:space:]' <"$active_theme_file" 2>/dev/null || true)"
  [ -n "$theme" ] || theme='argvus-dark'
  argvus_notifications_apply_theme "$theme" || die "notification theme is unavailable: $theme"
  printf 'theme=%s\n' "$theme"
}

apply_theme() {
  local theme="${1:-}"
  [ -n "$theme" ] || { usage >&2; exit 2; }
  argvus_notifications_apply_theme "$theme" || die "notification theme is unavailable: $theme"
  printf 'theme=%s\n' "$theme"
}

reload_theme() {
  local dnd_state
  dnd_state="$(read_dnd)"
  if [ "$dnd_state" = true ]; then
    mkdir -p "${pending_theme_reload_file%/*}"
    umask 077
    : >"$pending_theme_reload_file" || die 'failed to defer the notification theme reload'
    printf 'theme_reload=deferred\n'
    return
  fi

  if [ -n "${1:-}" ]; then
    dunstctl reload "$1" >/dev/null 2>&1 || die 'failed to reload the notification theme'
  else
    dunstctl reload >/dev/null 2>&1 || die 'failed to reload the notification theme'
  fi
  printf 'theme_reload=applied\n'
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
case "$1" in
  status)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    print_status
    ;;
  dnd)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    if [ "$2" != status ]; then
      acquire_state_lock
    fi
    case "$2" in
      status) print_status ;;
      on) set_dnd true ;;
      off) set_dnd false ;;
      toggle) toggle_dnd ;;
      restore)
        if [ -r "$state_file" ]; then
          value="$(tr -d '[:space:]' <"$state_file")"
          case "$value" in
            true) restore_dnd true ;;
            false) restore_dnd false ;;
            *) die 'stored DND preference is invalid' ;;
          esac
        else
          restore_dnd false
        fi
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  theme)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    case "$2" in
      apply)
        [ "$#" -eq 3 ] || { usage >&2; exit 2; }
        apply_theme "$3"
        ;;
      restore)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        restore_theme
        ;;
      reload)
        [ "$#" -le 3 ] || { usage >&2; exit 2; }
        acquire_state_lock
        reload_theme "${3:-}"
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
