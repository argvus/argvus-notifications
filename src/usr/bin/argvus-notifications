#!/usr/bin/env bash
set -eu

# shellcheck disable=SC1091
ARGVUS_NOTIFICATIONS_HELPER="${ARGVUS_NOTIFICATIONS_HELPER:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/notifications/sh/theme.sh}"
. "$ARGVUS_NOTIFICATIONS_HELPER"

usage() {
  printf '%s\n' \
    'Usage: argvus-notifications status' \
    '       argvus-notifications dnd status|on|off|toggle|restore' \
    '       argvus-notifications theme apply|restore [theme]'
}

die() {
  printf 'argvus-notifications: %s\n' "$1" >&2
  exit 1
}

have_dunstctl() {
  command -v dunstctl >/dev/null 2>&1 || die 'dunstctl is not available'
}

read_dnd() {
  have_dunstctl
  value="$(dunstctl is-paused 2>/dev/null || true)"
  case "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" in
    true) printf 'true\n' ;;
    false) printf 'false\n' ;;
    *) die 'Dunst returned an invalid pause state' ;;
  esac
}

print_status() {
  printf 'dnd=%s\n' "$(read_dnd)"
}

state_file="${XDG_STATE_HOME:-${HOME:?}/.local/state}/argvus/notifications/dnd"
active_theme_file="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-${HOME:?}/.config}}/argvus/.active-theme"

remember() {
  mkdir -p "$(dirname "$state_file")"
  umask 077
  printf '%s\n' "$1" >"$state_file"
}

set_dnd() {
  case "$1" in
    true|false) ;;
    *) die 'DND value must be true or false' ;;
  esac
  have_dunstctl
  dunstctl set-paused "$1" >/dev/null 2>&1 || die 'failed to change Dunst pause state'
  remember "$1"
  print_status
}

restore_dnd() {
  value="$1"
  case "$value" in
    true|false) ;;
    *) die 'DND value must be true or false' ;;
  esac
  have_dunstctl
  # Restore only Dunst's pause bit. Do not rewrite state or theme files.
  # Dunst is started immediately before this hook and may not have acquired
  # its D-Bus name yet. Retry briefly instead of making the service startup
  # race leave the runtime state out of sync with the persisted preference.
  attempt=0
  while ! dunstctl set-paused "$value" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 20 ] || die 'failed to restore Dunst pause state'
    sleep 0.1
  done
  print_status
}

toggle_dnd() {
  current="$(read_dnd)"
  if [ "$current" = true ]; then
    set_dnd false
  else
    set_dnd true
  fi
}

restore_theme() {
  local theme
  theme="$(tr -d '[:space:]' <"$active_theme_file" 2>/dev/null || true)"
  [ -n "$theme" ] || theme='argvus-dark'
  argvus_notifications_apply_theme "$theme" || die "notification theme is unavailable: $theme"
  printf 'theme=%s\n' "$theme"
}

apply_theme() {
  local theme="${1:-}"
  [ -n "$theme" ] || { usage >&2; exit 2; }
  argvus_notifications_apply_theme "$theme" || die "notification theme is unavailable: $theme"
  printf 'theme=%s\n' "$theme"
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
case "$1" in
  status)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    print_status
    ;;
  dnd)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    case "$2" in
      status) print_status ;;
      on) set_dnd true ;;
      off) set_dnd false ;;
      toggle) toggle_dnd ;;
      restore)
        if [ -r "$state_file" ]; then
          value="$(tr -d '[:space:]' <"$state_file")"
          case "$value" in
            true) restore_dnd true ;;
            false) restore_dnd false ;;
            *) die 'stored DND preference is invalid' ;;
          esac
        else
          restore_dnd false
        fi
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  theme)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    case "$2" in
      apply)
        [ "$#" -eq 3 ] || { usage >&2; exit 2; }
        apply_theme "$3"
        ;;
      restore)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        restore_theme
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
